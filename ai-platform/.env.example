# App
DEBUG=0
PORT=8000
CORS_ORIGINS=*

# Aliyun Credentials (required)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# Retry strategy (optional)
ALIYUN_VISION_MAX_RETRIES=3
ALIYUN_VISION_RETRY_BASE_SECONDS=0.5

# Pose detection API (optional overrides)
ALIYUN_POSE_DOMAIN=facebody.cn-shanghai.aliyuncs.com
ALIYUN_POSE_VERSION=2019-12-30
ALIYUN_POSE_ACTION=DetectBodyKeypoints

# Action recognition API (optional overrides)
ALIYUN_ACTION_DOMAIN=videorecog.cn-shanghai.aliyuncs.com
ALIYUN_ACTION_VERSION=2020-03-20
ALIYUN_ACTION_ACTION=RecognizeAction

# Skipping session state cache (optional)
SKIPPING_MAX_SESSIONS=2000
SKIPPING_SESSION_TTL_SECONDS=1800
