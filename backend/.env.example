# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=smart_sports

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# App
PORT=3000
# TypeORM synchronize 开关（已启用 migrations 机制，正常情况下保持 false）
# 仅在紧急需要自动对齐实体时临时设为 true，生产环境严禁开启
DB_SYNC=false
# 应用启动时是否自动执行迁移（默认 true；设为 false 则需手动 npm run migration:run）
DB_MIGRATIONS_RUN=true
NODE_ENV=development

# JWT（生产环境务必使用强随机字符串）
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# 阿里云人脸识别（人脸库 + SearchFace，EntityId 建议与 user.id 字符串一致）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_FACE_DB_NAME=default
ALIYUN_FACE_ENDPOINT=https://facebody.cn-shanghai.aliyuncs.com
ALIYUN_FACE_MATCH_THRESHOLD=0.6
ALIYUN_FACE_SEARCH_LIMIT=5

# 阿里云短信 SendSms（模板中变量名需与代码一致，默认 code）
ALIYUN_SMS_ENDPOINT=https://dysmsapi.aliyuncs.com
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# AI platform（用于作业 AI 自动评分）
AI_PLATFORM_BASE_URL=http://127.0.0.1:8000

# 阿里云 OSS（文件上传）
OSS_REGION=cn-shanghai
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
# 可选：如使用自定义域名/CDN，填 https://cdn.example.com
OSS_PUBLIC_BASE_URL=
# 可选：默认自动拼接 bucket endpoint；若填请用域名，不带路径
OSS_ENDPOINT=
OSS_DIR_PREFIX=uploads

# 上传限制（multer）
UPLOAD_MAX_MB=50
# 逗号分隔，按 MIME 前缀匹配
UPLOAD_ALLOWED_MIME_PREFIX=image/,video/

# Dashboard 统计阈值与积分
DASHBOARD_PASS_SCORE=60
DASHBOARD_EXCELLENT_SCORE=85
DASHBOARD_BASE_POINTS=5

# Alert 预警阈值
ALERT_VIOLATION_THRESHOLD=5

# 教育局成绩上报
EDU_SYNC_URL=
EDU_SYNC_TOKEN=
EDU_SYNC_TIMEOUT_MS=15000

# 外部系统接口（大屏）
EXTERNAL_ASSET_SUMMARY_URL=
EXTERNAL_ASSET_TOKEN=
EXTERNAL_SAFETY_EVENTS_URL=
EXTERNAL_SAFETY_TOKEN=
EXTERNAL_API_TIMEOUT_MS=10000
